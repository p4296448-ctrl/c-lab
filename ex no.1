#include <stdio.h> 
int main() 
 { 
  int a = 21; int b = 10; int c ; 
  c = a + b;printf(" Value of c = a+b is %d\n", c ); 
  c = a - b;printf(" Value of c = a-b is %d\n", c ); 
  c = a * b;printf(" Value of c = a*b is %d\n", c ); 
  c = a / b; printf(" Value of c = a/b is %d\n", c ); 
  c = a % b;   printf(" Value of c = a%%b is %d\n", c ); 
  c = ++a; printf(" Value of c = ++a is %d\n", c ); /* pre-incrementation */ 
  c = b++; printf(" Value of c = b++ is %d\n", c ); /* post-incrementation */
}
